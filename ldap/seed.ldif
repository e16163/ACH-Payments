# Ba's roles and permissions (docs/LDAP-PLAN.md section 1) and one demo user per role.
# A user is a member of role groups; a role is a member of permission groups. Passwords are set by setup.sh.

dn: dc=achpayments,dc=local
objectClass: dcObject
objectClass: organization
dc: achpayments
o: Demo Community Bank

dn: ou=people,dc=achpayments,dc=local
objectClass: organizationalUnit
ou: people

dn: ou=roles,dc=achpayments,dc=local
objectClass: organizationalUnit
ou: roles

dn: ou=permissions,dc=achpayments,dc=local
objectClass: organizationalUnit
ou: permissions

dn: uid=ldapadmin,ou=people,dc=achpayments,dc=local
objectClass: inetOrgPerson
uid: ldapadmin
cn: LDAP Admin
sn: Admin

dn: uid=ldaporig,ou=people,dc=achpayments,dc=local
objectClass: inetOrgPerson
uid: ldaporig
cn: LDAP Origination Operator
sn: Operator

dn: uid=ldaprecv,ou=people,dc=achpayments,dc=local
objectClass: inetOrgPerson
uid: ldaprecv
cn: LDAP Receiving Operator
sn: Operator

dn: uid=ldapcomp,ou=people,dc=achpayments,dc=local
objectClass: inetOrgPerson
uid: ldapcomp
cn: LDAP Compliance Officer
sn: Officer

# employeeNumber holds the member number (holderId in Ba's APIs)
dn: uid=ldapmember,ou=people,dc=achpayments,dc=local
objectClass: inetOrgPerson
uid: ldapmember
cn: LDAP Member
sn: Member
employeeNumber: M10982347

dn: cn=MEMBER,ou=roles,dc=achpayments,dc=local
objectClass: groupOfNames
cn: MEMBER
member: uid=ldapmember,ou=people,dc=achpayments,dc=local

